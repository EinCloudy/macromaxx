{
  "name": "macromaxx",
  "version": "0.1.0",
  "description": "Your shortcuts. One beautiful deck.",
  "desktopName": "macromaxx.desktop",
  "author": "MacroMaxx",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "node scripts/build-icon.js && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.0.0",
    "lucide-react": "^0.468.0",
    "obs-websocket-js": "^5.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.3",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "app.macromaxx.desktop",
    "productName": "MacroMaxx",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "plugins/**/*",
      "extensions/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "electron/*.py",
      "electron/*.sh",
      "node_modules/@img/**/*"
    ],
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "syncDesktopName": true,
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "sharp@0.35.5": true,
    "node-hid@3.4.0": true,
    "@julusian/jpeg-turbo@3.1.0": true,
    "electron@45.0.0": true
  }
}
